# Keep Unix line endings even on Windows checkouts - bash can't run scripts with CRLF endings.
*.sh    text eol=lf
*.conf  text eol=lf
*.txt   text eol=lf
*.java  text eol=lf
*.py    text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.bat   text eol=crlf
*.apk   binary
*.png   binary
*.p12   binary
READ[[:space:]]ME[[:space:]]FIRST.txt text eol=crlf
